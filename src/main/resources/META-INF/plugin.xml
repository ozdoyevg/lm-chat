<idea-plugin>
    <id>dev.lmchat</id>
    <name>LM Chat</name>
    <vendor>me</vendor>
    <description>Chat with models served by LM Studio through its OpenAI-compatible API, with project tools.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="dev.lmchat.LmSettings"/>
        <applicationConfigurable parentId="tools" instance="dev.lmchat.LmConfigurable"
                                 id="dev.lmchat.settings" displayName="LM Chat"/>
        <toolWindow id="LM Chat" anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowMessages"
                    factoryClass="dev.lmchat.ui.ChatToolWindowFactory"/>
    </extensions>
</idea-plugin>