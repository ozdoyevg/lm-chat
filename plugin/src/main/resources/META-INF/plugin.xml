<idea-plugin>
    <id>dev.lmchat</id>
    <name>LLM Chat</name>
    <vendor>me</vendor>
    <description>Chat and inline code completion with models served by LM Studio, Ollama or other OpenAI-compatible providers.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="dev.lmchat.ide.settings.LmSettings"/>
        <applicationService serviceImplementation="dev.lmchat.ide.completion.CompletionService"/>
        <applicationConfigurable parentId="tools" instance="dev.lmchat.ide.settings.SettingsConfigurable"
                                 id="dev.lmchat.settings" displayName="LM Chat"/>
        <toolWindow id="LM Chat" anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowMessages"
                    factoryClass="dev.lmchat.ide.chat.ChatToolWindowFactory"/>
        <postStartupActivity implementation="dev.lmchat.ide.completion.CompletionStartup"/>
        <editorActionHandler action="EditorTab"
                             implementationClass="dev.lmchat.ide.completion.TabAcceptHandler" order="first"/>
    </extensions>
</idea-plugin>